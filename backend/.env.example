# アプリ実行環境（development | staging | production）
APP_ENV=development

# PostgreSQL 接続文字列
# docker-compose 環境では host を db（サービス名）に変更すること
DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/allergy_scan?schema=public"
POSTGRES_PASSWORD=your-postgres-password

# AWS S3（画像アップロード用）
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=allergy-scan-images

# EC2/Lambda 実行環境では不要（IAM Role で付与）。ローカル開発時のみ設定
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ローカル開発時のみ（MinIO 等のS3互換ストレージ）。本番では設定しない
# AWS_ENDPOINT_URL=http://localhost:9000

# Gemini Flash API（OCR・アレルギー判定用）
GEMINI_API_KEY=your-gemini-api-key

# Google Places API（店舗名取得用）
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# 店舗検索プロバイダー（google | overpass | hybrid）
# hybrid: Google Places が利用不可の場合に Overpass API へフォールバック
PLACES_PROVIDER=hybrid

# Cookie 署名シークレット（32 文字以上の無作為な文字列を設定すること）
COOKIE_SECRET=your-cookie-secret-32chars-minimum

# Supabase Auth
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# Admin Seeder（開発環境専用）
SEED_ADMIN_EMAIL=admin@allergy-scan.dev
SEED_ADMIN_PASSWORD=change-this-in-dev

# サーバーリッスンポート
PORT=3001

# CORS 許可オリジン（本番環境ではフロントエンドの実際の URL に変更すること）
CORS_ORIGIN=http://localhost:3000

# 楽天市場API
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=